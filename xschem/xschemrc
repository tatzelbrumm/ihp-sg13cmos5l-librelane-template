# Project-local xschemrc for ihp-sg13cmos5l-librelane-template
#
# Purpose:
# - load the IHP PDK xschem setup first
# - then add this project's own schematic/symbol/test paths
#
# Assumes:
#   PDK_ROOT and PDK are already exported by the nix shell.

if {![info exists env(PDK_ROOT)]} {
  puts stderr "ERROR: PDK_ROOT is not set."
  return
}

if {![info exists env(PDK)]} {
  puts stderr "ERROR: PDK is not set."
  return
}

set pdk_xschemrc [file normalize "$env(PDK_ROOT)/$env(PDK)/libs.tech/xschem/xschemrc"]

if {![file exists $pdk_xschemrc]} {
  puts stderr "ERROR: PDK xschemrc not found: $pdk_xschemrc"
  return
}

# Load the PDK's own xschem setup first.
source $pdk_xschemrc

# Absolute path of this project's xschem directory and repo root.
set PROJECT_XSCHEM_DIR [file dirname [info script]]
set PROJECT_ROOT       [file normalize "$PROJECT_XSCHEM_DIR/.."]

# Add a library path only if it is not already present.
proc add_xschem_lib_unique {path} {
  global XSCHEM_LIBRARY_PATH

  set norm [file normalize $path]

  if {![info exists XSCHEM_LIBRARY_PATH] || $XSCHEM_LIBRARY_PATH eq ""} {
    set XSCHEM_LIBRARY_PATH $norm
    return
  }

  foreach p [split $XSCHEM_LIBRARY_PATH :] {
    if {[file normalize $p] eq $norm} {
      return
    }
  }

  append XSCHEM_LIBRARY_PATH :$norm
}

# Project-local libraries.
add_xschem_lib_unique $PROJECT_XSCHEM_DIR
add_xschem_lib_unique "$PROJECT_XSCHEM_DIR/symbols"
add_xschem_lib_unique "$PROJECT_XSCHEM_DIR/tests"

# Convenience environment variables for scripts and launcher symbols.
set env(PROJECT_ROOT)         $PROJECT_ROOT
set env(PROJECT_XSCHEM_DIR)   $PROJECT_XSCHEM_DIR
set env(PROJECT_SIM_DIR)      [file normalize "$PROJECT_ROOT/sim"]
set env(PROJECT_NETLIST_DIR)  [file normalize "$PROJECT_ROOT/sim/netlists"]
set env(PROJECT_RAW_DIR)      [file normalize "$PROJECT_ROOT/sim/raw"]
set env(PROJECT_MEAS_DIR)     [file normalize "$PROJECT_ROOT/sim/meas"]
set env(PROJECT_GDS_DIR)      [file normalize "$PROJECT_ROOT/gds"]
set env(PROJECT_KLAYOUT_DIR)  [file normalize "$PROJECT_ROOT/klayout"]
set env(PROJECT_MAGIC_DIR)    [file normalize "$PROJECT_ROOT/magic"]
set env(PROJECT_LEF_DIR)      [file normalize "$PROJECT_ROOT/lef"]

puts "Loaded project xschemrc: $PROJECT_XSCHEM_DIR/xschemrc"
puts "PROJECT_ROOT=$PROJECT_ROOT"
puts "XSCHEM_LIBRARY_PATH=$XSCHEM_LIBRARY_PATH"
